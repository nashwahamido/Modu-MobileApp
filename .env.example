# Copy to .env for local development. .env is gitignored; this file is the documented shape.
#
# READ THIS BEFORE BUILDING A RELEASE.
#
# Every EXPO_PUBLIC_* variable is INLINED INTO THE JS BUNDLE as a literal string at build time.
# A __DEV__ guard controls whether code RUNS; it has no effect on whether a string is PRESENT.
# Anyone can unzip an APK and read the bundle. So the only thing that keeps a credential out of a release build is not setting it when that build runs — which is why eas.json defines the flavour switches per profile and deliberately defines nothing else.
#
# Anything without the EXPO_PUBLIC_ prefix is NOT bundled. It reaches node scripts only, and must
# never be added to eas.json.

# --- required everywhere -------------------------------------------------------------------
# The anon key is designed to be public and is gated by RLS, so it is safe in a shipped bundle.
# Missing either of these throws at launch (src/config/supabase.ts) rather than degrading.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "supabase" for the live backend; anything else selects the in-memory adapter, which has no auth.
EXPO_PUBLIC_DATA_BACKEND=supabase

# --- flavour switches (set per profile in eas.json, not here, for builds) -------------------
# 1 shows the SHOWCASE account roster. NOT __DEV__ gated (src/dev/showcase.ts) — a release build with this set really does ship the showcase roster and its shared password, which is the point of the demo flavour and the reason production leaves it at 0.
EXPO_PUBLIC_SHOWCASE=0

# 1 routes bundled furniture through serialize -> JSON -> parse -> compose, to feel the wire format on device. __DEV__ gated (src/game/content/loadFurniture.ts), so it is inert in any release.
EXPO_PUBLIC_RECIPE_MODE=1

# --- dev roster: NEVER set these for a production build --------------------------------------
# One password shared by the whole roster. src/dev/devAccounts.ts says a release build must never carry it — that requirement is met by leaving these unset at build time, not by the __DEV__ guard above it. Absent degrades cleanly: parseAccounts returns [] (src/dev/accounts.ts).
EXPO_PUBLIC_DEV_ACCOUNTS=
EXPO_PUBLIC_DEV_PASSWORD=

# Optional: name a dev account here to sign into it automatically on launch (src/dev/devAuth.ts).
# Leave UNSET to open on the account picker and choose instead — that empty value IS the picker switch.
EXPO_PUBLIC_DEV_EMAIL=

# --- showcase roster: only for the demo flavour -----------------------------------------------
# Same shared-password caveat. Set these ONLY on a profile that also sets EXPO_PUBLIC_SHOWCASE=1, and only for internal distribution.
EXPO_PUBLIC_SHOWCASE_ACCOUNTS=
EXPO_PUBLIC_SHOWCASE_PASSWORD=

# delete new accounts cascades after demo:
# select id, created_at, raw_user_meta_data ->> 'username' as username from auth.users where is_anonymous order by created_at;
# delete from auth.users where is_anonymous;


# --- node scripts only, NEVER bundled ---------------------------------------------------------
# No EXPO_PUBLIC_ prefix, so Expo does not inline it. Overwrites production catalogue assets (scripts/fix-catalog-webp.mjs --apply), so it is opt-in and lives only on a developer machine.
SUPABASE_SERVICE_ROLE_KEY=
