# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Data backend for src/data: "supabase" to use the live tables, anything else = in-memory fake data.
EXPO_PUBLIC_DATA_BACKEND=

# --- Test accounts -----------------------------------------------------------
# ONE switch picks which roster is live, so the two can never both be on:
#   EXPO_PUBLIC_SHOWCASE=0  the DEV roster (src/dev/devAccounts.ts), __DEV__ + supabase backend only
#   EXPO_PUBLIC_SHOWCASE=1  the SHOWCASE roster (src/dev/showcase.ts), works in release builds too
EXPO_PUBLIC_SHOWCASE=

# The dev roster. One shared password for all of them.
# [{"label":"Dev A — level 2","email":"dev-a@example.com"},{"label":"Dev B — level 20","email":"dev-b@example.com"}]
EXPO_PUBLIC_DEV_ACCOUNTS=
EXPO_PUBLIC_DEV_PASSWORD=

# Optional: name a dev account here to sign into it automatically on launch (src/dev/devAuth.ts).
# Leave UNSET to open on the account picker and choose instead — that empty value IS the picker switch.
EXPO_PUBLIC_DEV_EMAIL=

# The showcase roster. Release builds compile every EXPO_PUBLIC_* value INTO THE BUNDLE, readable by
# anyone holding the app — so throwaway accounts on a project with nothing real in it.
# [{"label":"Ada — level 8, furnished","email":"demo-ada@example.com"},{"label":"Kit — level 2","email":"demo-kit@example.com"}]
EXPO_PUBLIC_SHOWCASE_ACCOUNTS=
EXPO_PUBLIC_SHOWCASE_PASSWORD=

# delete new accounts cascades after demo:
# select id, created_at, raw_user_meta_data ->> 'username' as username from auth.users where is_anonymous order by created_at;
# delete from auth.users where is_anonymous;
