{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_BACKEND": "supabase",
        "EXPO_PUBLIC_SHOWCASE": "0",
        "EXPO_PUBLIC_RECIPE_MODE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_BACKEND": "supabase",
        "EXPO_PUBLIC_SHOWCASE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_BACKEND": "supabase",
        "EXPO_PUBLIC_SHOWCASE": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
