{
 "name": "modu-mobile-app",
 "version": "0.1.0",
 "main": "expo-router/entry",
 "scripts": {
  "postinstall": "patch-package",
  "start": "npx expo start",
  "android": "npx expo run:android",
  "ios": "npx expo run:ios",
  "test": "tsx --test \"src/**/*.test.ts\"",
  "typecheck": "tsc --noEmit",
  "fix:ios-paths": "node scripts/fix-ios-space-paths.mjs",
  "compress:room": "node scripts/compress-room-glb.mjs",
  "compress:furniture": "node scripts/compress-furniture-glb.mjs",
  "snapshot:glb": "node scripts/glb-snapshot.mjs",
  "build:room": "node scripts/compress-room-glb.mjs src/assets/models/room/room_empty.glb src/assets/models/room/_pass1.glb && node scripts/set-shell-blend-modes.mjs src/assets/models/room/_pass1.glb src/assets/models/room/_pass2.glb && node scripts/set-ao-strength.mjs src/assets/models/room/_pass2.glb src/assets/models/room/_pass3.glb 0.6 && node scripts/declare-shell-map-slots.mjs src/assets/models/room/_pass3.glb src/assets/models/room/virtualroom_empty.glb && node -e \"for (const f of ['_pass1','_pass2','_pass3']) require('fs').rmSync(`src/assets/models/room/${f}.glb`, {force: true})\" && node scripts/extract-shell-defaults.mjs && tsx scripts/verify-room-glb.mts",
  "verify:room": "tsx scripts/verify-room-glb.mts",
  "upload:assembly": "tsx scripts/upload-assembly.mts",
  "test:unit": "node --import tsx --test \"src/game/**/*.test.ts\"",
  "processGLB": "node tools/processGLB/processGLB.mjs",
    "processGLB:test": "node --test tools/processGLB/test/",
    "furniture:validate": "node --import tsx src/game/helper-scripts/validate-furniture.ts",
    "furniture:test": "node --import tsx src/game/helper-scripts/engine-test.ts",
    "thumbs": "node src/game/helper-scripts/thumbs.mjs",
    "render:thumbs:blender": "node src/game/helper-scripts/render-thumbs-blender.mjs",
    "gen:thumbs": "node src/game/helper-scripts/gen-thumbs.mjs"
 },
 "dependencies": {
  "@react-native-async-storage/async-storage": "2.2.0",
  "@supabase/supabase-js": "^2.49.0",
  "expo": "~54.0.34",
  "expo-asset": "~12.0.13",
  "expo-audio": "~1.1.1",
  "expo-constants": "~18.0.13",
  "expo-dev-client": "~6.0.21",
  "expo-font": "~14.0.11",
  "expo-haptics": "~15.0.8",
  "expo-image": "~3.0.11",
  "expo-linking": "~8.0.12",
  "expo-navigation-bar": "~5.0.10",
  "expo-router": "~6.0.23",
  "expo-screen-orientation": "~9.0.9",
  "expo-speech": "~14.0.8",
  "expo-splash-screen": "~31.0.13",
  "expo-status-bar": "~3.0.9",
  "expo-symbols": "~1.0.8",
  "expo-system-ui": "~6.0.9",
  "expo-web-browser": "~15.0.11",
  "lottie-react-native": "~7.3.1",
  "react": "19.1.0",
  "react-dom": "19.1.0",
  "react-native": "0.81.5",
  "react-native-filament": "^1.11.0",
  "react-native-gesture-handler": "~2.28.0",
  "react-native-reanimated": "~4.1.1",
  "react-native-safe-area-context": "~5.6.0",
  "react-native-screens": "~4.16.0",
  "react-native-svg": "15.12.1",
  "react-native-web": "~0.21.0",
  "react-native-worklets": "0.5.1",
  "zustand": "^5.0.14"
 },
 "devDependencies": {
  "@gltf-transform/core": "^4.4.2",
  "@gltf-transform/extensions": "^4.4.2",
  "@gltf-transform/functions": "^4.4.2",
  "@types/node": "^26.1.1",
  "@types/react": "~19.1.0",
  "eslint": "^9.25.0",
  "eslint-config-expo": "~10.0.0",
  "meshoptimizer": "^1.2.0",
  "patch-package": "^8.0.1",
  "sharp": "^0.34.5",
  "tsx": "^4.22.4",
  "typescript": "~5.9.2"
 },
 "private": true
}
